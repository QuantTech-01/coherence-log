---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Notes on quantum sensing and software, every ten days.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <div class="eyebrow" style="margin-top:2rem;">Coherence Log</div>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`} style="text-decoration:none;">
        <h1 style="font-size:2.1rem; margin-top:0.2rem;">Coherence Log</h1>
      </a>
      <p style="color:var(--muted); margin-top:-0.4rem; max-width:32em;">
        A running record of quantum sensing research and software-engineering
        trends, read out every ten days.
      </p>

      <svg class="resonance-line" viewBox="0 0 800 90" width="100%" height="70" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0,30 L260,30 C300,30 300,75 340,75 C380,75 380,15 420,15 C460,15 460,30 500,30 L800,30"
          fill="none"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-dasharray="900"
          stroke-dashoffset="0"
        />
      </svg>
    </header>

    <main>
      <slot />
    </main>

    <hr class="rule" />
    <footer class="eyebrow" style="display:flex; justify-content:space-between;">
      <span>Coherence Log — quantum sensing &amp; software</span>
      <span>Auto-drafted every 10 days, reviewed by a human</span>
    </footer>
  </body>
</html>
