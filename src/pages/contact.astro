---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Coherence Log">
  <div class="eyebrow">Contact</div>
  <h1>Get in touch</h1>
  <p>Questions, corrections, or a paper/story you think I should cover — send it here.</p>

  <form action="https://formspree.io/f/xppapzjo" method="POST" style="display:flex; flex-direction:column; gap:1rem; max-width:32em;">
    <label>
      <div class="eyebrow" style="margin-bottom:0.3rem;">Your email</div>
      <input type="email" name="email" required style="width:100%; padding:0.6rem; border:1px solid var(--rule); background:transparent; color:inherit; font-family:var(--font-body);" />
    </label>
    <label>
      <div class="eyebrow" style="margin-bottom:0.3rem;">Message</div>
      <textarea name="message" required rows="6" style="width:100%; padding:0.6rem; border:1px solid var(--rule); background:transparent; color:inherit; font-family:var(--font-body);"></textarea>
    </label>
    <button type="submit" style="padding:0.7rem 1.2rem; background:var(--ink); color:var(--paper); border:none; cursor:pointer; font-family:var(--font-mono); text-transform:uppercase; font-size:0.8rem; letter-spacing:0.05em;">Send</button>
  </form>
</BaseLayout>
